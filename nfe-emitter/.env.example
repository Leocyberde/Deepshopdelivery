# Token compartilhado com o app (NFE_SERVICE_TOKEN no .env do app). Gere com: openssl rand -hex 32
EMITTER_TOKEN=
# Certificado A1 (.pfx) FORA da pasta pública. Nunca commitar.
NFE_CERT_PATH=/etc/deepshop/certificado.pfx
NFE_CERT_PASSWORD=
# XMLs autorizados + DANFE: guarde 5 anos e faça backup diário (exigência legal).
NFE_STORAGE_DIR=/var/lib/deepshop-nfe
# Leiaute (PL_009_V4 vale até a obrigatoriedade de IBS/CBS para o Simples/MEI, prevista para 04/01/2027).
NFE_SCHEMA=PL_009_V4
NFE_VER_PROC=DeepShop 1.0
# Responsável técnico (opcional; exigido por algumas UFs). Quem desenvolve/mantém o sistema.
NFE_RESP_TEC_CNPJ=
NFE_RESP_TEC_CONTATO=
NFE_RESP_TEC_EMAIL=
NFE_RESP_TEC_FONE=
