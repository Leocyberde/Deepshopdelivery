# Ambiente
NODE_ENV=production
PORT=3000
# URL-base absoluta: em produção somente HTTPS, domínio não local e raiz (sem path/query/fragmento).
# CORS permite somente esta origin exata; em desenvolvimento HTTP local é permitido.
SITE_URL=https://seu-dominio.com.br
# Mercado Pago Checkout Pro: somente token de TESTE; não há fallback para token de produção.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_TEST_ACCESS_TOKEN=
# Assinatura secreta dos Webhooks do Mercado Pago; somente backend, nunca frontend.
MERCADOPAGO_WEBHOOK_SECRET=
# Tolerância do timestamp x-signature em segundos.
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
# Número de proxies reversos na frente do app (Nginx/Caddy = 1)
TRUST_PROXY=1

# Segurança (obrigatório em produção: mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Primeiro administrador (usado só quando ainda não existe admin; senha com mínimo de 10 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL real (fora do código; DATABASE_URL também pode ser usado)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=achadinhos
PGUSER=achadinhos_app
PGPASSWORD=
PGSSL=false
PGPOOL_MAX=10
# Backups sempre fora da pasta pública/build
BACKUP_DIR=/var/lib/achadinhos/backups

# Aviso de novo pedido e lembrete no WhatsApp do dono (CallMeBot)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Catálogo inicial (seedData.ts). Em produção fica DESLIGADO por padrão; use true só se quiser carregá-lo.
SEED_INITIAL_CATALOG=false
